# Comma-separated keys — picker rotates randomly each call
GROQ_API_KEYS=gsk_xxx,gsk_yyy
DEEPGRAM_API_KEYS=dg_xxx,dg_yyy

GROQ_MODEL=openai/gpt-oss-20b

# LLM: groq | sarvam  (sarvam = better Indian English / Hinglish for this coach)
LLM_PROVIDER=sarvam
SARVAM_API_KEYS=sk_xxx
SARVAM_MODEL=sarvam-105b-conversations

# Deepgram STT (live call)
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_STT_LANGUAGE_FALLBACKS=en-US,en-IN
DEEPGRAM_STT_ENDPOINTING_MS=300

# Deepgram TTS — aura-helios-en (fast) or flux-haley-en (agent /v2)
DEEPGRAM_TTS_MODEL=aura-helios-en
DEEPGRAM_TTS_SPEED=0.90

SAMPLE_RATE=16000

# MongoDB Atlas (or local) — session transcripts / keywords
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_talk

# Optional — long-term vector memory (100k users). Empty = Mongo per-learner vectors.
# Live call never waits on this (hydrate at join, upsert after turn).
# PINECONE_API_KEY=
# PINECONE_INDEX=ai-talk-memory

# Optional legacy (not required for live WebSocket path)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=ai-talk
# CLOUDINARY_CDN_SUBDOMAIN=true
