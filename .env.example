# Comma-separated keys — picker rotates randomly each call
GROQ_API_KEYS=gsk_xxx,gsk_yyy
DEEPGRAM_API_KEYS=dg_xxx,dg_yyy

GROQ_MODEL=openai/gpt-oss-20b

# Deepgram STT (live call)
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_STT_LANGUAGE_FALLBACKS=en-US,en-IN
DEEPGRAM_STT_ENDPOINTING_MS=300

# Deepgram TTS (live call) — aura-helios-en was fastest in our benches
DEEPGRAM_TTS_MODEL=aura-helios-en
DEEPGRAM_TTS_SPEED=1.25

SAMPLE_RATE=16000

# MongoDB Atlas (or local) — session transcripts / keywords
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_talk

# Optional legacy (not required for live WebSocket path)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=ai-talk
# CLOUDINARY_CDN_SUBDOMAIN=true
