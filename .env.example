# Comma-separated keys — picker rotates randomly each call
GROQ_API_KEYS=gsk_xxx,gsk_yyy
DEEPGRAM_API_KEYS=dg_xxx,dg_yyy

GROQ_MODEL=openai/gpt-oss-20b

# LLM: groq | sarvam  (sarvam = better Indian English / Hinglish for this coach)
LLM_PROVIDER=sarvam
SARVAM_API_KEYS=sk_xxx
SARVAM_MODEL=sarvam-105b-conversations

# Deepgram STT (live call)
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_STT_LANGUAGE_FALLBACKS=en-US,en-IN
DEEPGRAM_STT_ENDPOINTING_MS=300

# Deepgram TTS — aura-helios-en (fast) or flux-haley-en (agent /v2)
DEEPGRAM_TTS_MODEL=aura-helios-en
DEEPGRAM_TTS_SPEED=0.90

SAMPLE_RATE=16000

# MongoDB — schema/indexes at boot. `users` is owned elsewhere (do not recreate).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_talk

# Qdrant — one collection for semantic memory (not progress / not full transcripts)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=english_coach_memories
QDRANT_DISTANCE=COSINE
TENANT_ID=talkengly

# Embeddings — dimension must match the selected model / Qdrant collection
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-v1
EMBEDDING_DIMENSION=384
EMBEDDING_VERSION=v1
# When the embedding model changes, switch collection then reindex:
# QDRANT_COLLECTION=english_coach_memories_v2
# EMBEDDING_VERSION=v2

# Same Atlas cluster, different DB that owns `users` (read-only). Empty = MONGODB_DB.
# This project stores coach data in MONGODB_DB (ai_talk). Real learners live elsewhere.
USERS_MONGO_DB=talkengly

# Live voice vs post-call analysis (seconds / tokens)
LIVE_LLM_TIMEOUT=5
POST_CALL_LLM_TIMEOUT=30
LIVE_LLM_MAX_TOKENS=160
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=ai-talk
# CLOUDINARY_CDN_SUBDOMAIN=true
